{
  "name": "sre-oncall-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Build an AI SRE first responder with local Claude Code. The Agent SDK investigates with read-only tools; humans approve and act. Explicit offline fallback for scripted replay.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/*.test.ts\"",
    "fixtures": "node fixtures/generate.mjs",
    "investigate": "tsx src/cli.ts",
    "approve": "tsx src/cli.ts --approve",
    "reject": "tsx src/cli.ts --reject",
    "watch": "tsx src/cli.ts --watch",
    "bench": "tsx src/bench.ts",
    "verify": "npm run typecheck && npm test && npm run bench",
    "course:build": "node course/build.mjs",
    "course:check": "node course/build.mjs --check",
    "diagrams": "node docs/diagrams/build.mjs",
    "video": "node docs/video/build.mjs",
    "doctor": "tsx src/ops.ts doctor",
    "model:check": "tsx src/modelCheck.ts",
    "shop": "tsx demo/shop.ts",
    "traffic": "tsx demo/chaos.ts traffic",
    "chaos": "tsx demo/chaos.ts",
    "live": "tsx src/ops.ts live",
    "watch-deploy": "tsx src/ops.ts watch-deploy",
    "execute": "tsx src/ops.ts execute",
    "demo": "bash demo/run.sh",
    "demo:watch": "bash demo/watch-demo.sh",
    "e2e": "tsx src/e2e.ts",
    "console": "tsx console/server.ts",
    "check": "npm run verify",
    "test:workshop": "tsx --test \"test/workshop/*.test.ts\"",
    "test:workshop-support": "node --test test/workshop-launcher.test.mjs test/checkpoint.test.mjs",
    "test:hooks": "node test/hooks.test.mjs && node test/progress.test.mjs && node test/progress-note.test.mjs && node test/config.test.mjs && npm run test:workshop-support",
    "approve:git": "node scripts/approve.mjs",
    "check:approval": "node scripts/check-approval.mjs",
    "skill:scan": "node scripts/scan-skill.mjs",
    "progress": "node .claude/hooks/progress.mjs --status",
    "progress:note": "node scripts/progress-note.mjs",
    "workshop:check": "node scripts/workshop-check.mjs",
    "card": "node scripts/card.mjs",
    "card:check": "node scripts/card.mjs --check",
    "hub": "node scripts/hub.mjs",
    "checkpoint": "node scripts/checkpoint.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.274",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
