{
  "name": "sre-oncall-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI SRE first responder on the Claude Agent SDK: investigates an alert with read-only tools, proposes one next step with cited evidence, drafts an approval a human signs, then watches the fix land. Offline by default.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/*.test.ts\"",
    "fixtures": "node fixtures/generate.mjs",
    "investigate": "tsx src/cli.ts",
    "approve": "tsx src/cli.ts --approve",
    "reject": "tsx src/cli.ts --reject",
    "watch": "tsx src/cli.ts --watch",
    "bench": "tsx src/bench.ts",
    "verify": "npm run typecheck && npm test && npm run bench",
    "course:build": "node course/build.mjs",
    "course:check": "node course/build.mjs --check",
    "diagrams": "node docs/diagrams/build.mjs",
    "video": "node docs/video/build.mjs",
    "doctor": "tsx src/ops.ts doctor",
    "shop": "tsx demo/shop.ts",
    "traffic": "tsx demo/chaos.ts traffic",
    "chaos": "tsx demo/chaos.ts",
    "live": "tsx src/ops.ts live",
    "watch-deploy": "tsx src/ops.ts watch-deploy",
    "execute": "tsx src/ops.ts execute",
    "demo": "bash demo/run.sh",
    "demo:watch": "bash demo/watch-demo.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.274",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
